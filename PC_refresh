<script language="javascript">
/* ============================================================
   ロジック部 ： IE11(JScript)互換（var / function / Enumerator / try-catch）
   ============================================================ */

// --- ウィンドウ初期化 ---
// 余裕を持たせつつ、画面に収まる範囲にクランプ（小さい画面でもはみ出さない）。
// 画面に収まりきらない分は #main の縦スクロールで救済する。
var W = 740, H = 960;
try {
    if (W > screen.availWidth  - 20) W = screen.availWidth  - 20;
    if (H > screen.availHeight - 20) H = screen.availHeight - 20;
    window.resizeTo(W, H);
    window.moveTo(Math.floor((screen.availWidth - W) / 2), Math.floor((screen.availHeight - H) / 2));
} catch (e) {}

// --- ActiveX ---
var shell = null, fso = null;
try { shell = new ActiveXObject("WScript.Shell"); } catch (e) {}
try { fso   = new ActiveXObject("Scripting.FileSystemObject"); } catch (e) {}

// --- 共通状態 ---
var GB = 1073741824, MB = 1048576;
var currentStep = 1;
var oneDrivePath = "";
var targetDrive = "C:";
var beforeFreeGB = 0;
var lastFreeGB = 0;
var ringCirc = 0;
var pollTimer = null, animTimer = null;
var lastPollFree = 0;
var junkScanned = false;
var junkTargets = [];
var folderRoot = "USER";
var isElevated = false;
var isScanning = false;

// ---------- 起動 ----------
function boot() {
    setupGaugeRing();
    detectOneDrive();
    applyAdminUI();
    scanDrive(true);
    showPanel(1);
    showTab("onedrive");
}

/* ============================================================
   管理者権限の判定 / 表示
   ============================================================ */
// 非管理者だと HKU\S-1-5-19（LocalServiceのハイブ）の読み取りで例外が出る、
// という挙動を利用した簡易判定。失敗側に倒して安全側（=非管理者扱い）に。
function isAdmin() {
    if (!shell) return false;
    try { shell.RegRead("HKEY_USERS\\S-1-5-19\\Environment\\TEMP"); return true; }
    catch (e) { return false; }
}
function applyAdminUI() {
    isElevated = isAdmin();
